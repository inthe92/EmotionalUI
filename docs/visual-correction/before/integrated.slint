import "../../assets/fonts/DejaVuSerif.ttf";
export global QuietDesign {
    out property <color> paper:#eee9df;
    out property <color> ink:#2c3431;
    out property <color> muted:#59615b;
    out property <color> mark:#456357;
    out property <length> margin:32px;
    out property <duration> transition:180ms;
}
component QuietAction inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> reduced;
    in property <bool> pressed;
    in property <bool> enabled:true;
    callback chosen();
    background:root.pressed?QuietDesign.mark.with-alpha(0.12):transparent;
    property <length> nudge:root.focused&&!root.reduced?3px:0px;
    animate nudge {duration:root.reduced?0ms:120ms;easing:ease-out;}
    Text {x:nudge;y:0px;width:parent.width;height:parent.height - 4px;text:root.label;color:QuietDesign.ink;font-size:18px;font-weight:root.focused?600:400;vertical-alignment:center;overflow:elide;}
    Rectangle {x:0px;y:parent.height - 3px;width:root.focused?parent.width:20px;height:root.focused?2px:1px;background:root.focused?QuietDesign.mark:QuietDesign.muted.with-alpha(0.4);}
    Rectangle {x:-10px;y:parent.height/2 - 3px;width:3px;height:6px;background:QuietDesign.mark;visible:root.focused;}
    TouchArea {enabled:root.enabled;clicked=>{root.chosen();}}
}
export component RoomScene inherits Rectangle {
    in property <int> phase;
    in property <int> weather;
    in property <int> season;
    in property <int> decoration;
    in property <bool> reduced;
    background:#777e79;clip:true;
    Image {x:0px;y:0px;width:640px;height:480px;source:@image-url("../../assets/scenes/room-v1/master.png");image-fit:contain;}
    property <color> tint:root.phase==0?#e4d6b41d:root.phase==1?#f7efce00:root.phase==2?#b2945b22:root.phase==3?#73567055:root.phase==4?#122135aa:#142427c0;
    property <float> lamp:root.phase==3?0.22:root.phase==4?0.37:root.phase==5?0.14:0;
    property <float> cloud:root.weather==1?0.14:root.weather==2?0.22:root.weather==3?0.28:0;
    animate tint,lamp,cloud {duration:root.reduced?0ms:220ms;}
    Rectangle {width:parent.width;height:parent.height;background:root.tint;}
    Rectangle {width:parent.width;height:parent.height;background:#303c46;opacity:root.cloud;}
    // Shared window coordinates; overlays never move the camera or furniture.
    Rectangle {x:94px;y:18px;width:288px;height:187px;background:root.season==3?#87734c18:root.season==0?#a9c2c330:root.season==1?#78a68a12:transparent;}
    Rectangle {x:382px;y:192px;width:112px;height:43px;background:@linear-gradient(90deg,#eac48b00,#eac48b,#eac48b00);opacity:root.lamp;}
    Rectangle {x:398px;y:172px;width:20px;height:4px;background:#f4d2a3;opacity:root.lamp;}
    Rectangle {
        property <float> show:root.weather==2?1:0;opacity:show;visible:show>0;animate show {duration:root.reduced?0ms:220ms;}
        x:94px;y:18px;width:288px;height:187px;background:transparent;clip:true;
        for index in 22: Rectangle {x:6px+mod(index*37,278)*1px;y:mod(index*43,168)*1px;width:1px;height:13px;background:#d6e1de55;}
    }
    Rectangle {property <float> show:root.weather==3?1:0;opacity:show;visible:show>0;animate show {duration:root.reduced?0ms:220ms;}x:94px;y:18px;width:288px;height:187px;background:#d4dfdb66;}
    Rectangle {property <float> show:root.weather==4?1:0;opacity:show;visible:show>0;animate show {duration:root.reduced?0ms:220ms;}x:94px;y:18px;width:288px;height:187px;background:#d9dfdf22;
        for index in 25: Rectangle {x:mod(index*47,280)*1px;y:mod(index*31,180)*1px;width:2px;height:2px;background:#eeeae2;}
    }
    // Small editorial ornaments are provisional, deliberately static.
    if root.decoration==1: Rectangle {x:275px;y:220px;width:17px;height:13px;border-radius:6px;background:#ad7349;Rectangle{x:8px;y:-3px;width:2px;height:4px;background:#58634c;}}
    if root.decoration==2: Rectangle {x:276px;y:211px;width:15px;height:23px;background:transparent;
        Text{text:"✦";font-size:23px;color:#d8c595;}
    }
    if root.decoration==3: Text {x:275px;y:212px;text:"✧";font-size:22px;color:#d6cead;}
}
export component Integrated inherits Rectangle {
    in property <bool> resume;
    in property <bool> has-recent;
    in property <string> recent-title;
    in property <int> recent-artwork;
    in property <string> statistics;
    in property <bool> demo-history;
    in property <string> title;
    in property <string> alternative;
    in property <string> clock;
    in property <string> play;
    in property <int> count;
    in property <int> selected;
    in property <int> phase;
    in property <int> weather;
    in property <int> season;
    in property <int> decoration;
    in property <bool> reduced;
    in property <bool> ambient-motion;
    in property <bool> blocked;
    in property <bool> confirmed;
    in property <bool> art-available;
    in property <float> reveal;
    callback activated(int);
    background:QuietDesign.paper;
    // Logical state changes immediately; only decoration/position interpolates.
    Rectangle {
        property <float> show:root.resume?1:0;
        x:(1-show)*-8px;y:0px;width:640px;height:480px;background:QuietDesign.paper;
        visible:root.resume;opacity:1;
        animate show {duration:root.reduced?0ms:QuietDesign.transition;easing:ease-out;}
        Text {x:32px;y:26px;text:"emotional";font-size:14px;font-weight:600;letter-spacing:1px;color:QuietDesign.muted;}
        Text {x:505px;y:26px;width:103px;text:root.clock;horizontal-alignment:right;font-size:14px;color:QuietDesign.muted;}
        Text {x:32px;y:79px;text:root.demo-history?"UNA PARTIDA DE MUESTRA":root.has-recent?"DONDE LO DEJASTE":"CUANDO QUIERAS";font-size:11px;letter-spacing:1.5px;color:QuietDesign.muted;}
        Text {x:32px;y:114px;width:360px;height:102px;text:root.recent-title;wrap:word-wrap;overflow:elide;font-family:"DejaVu Serif";font-size:30px;color:QuietDesign.ink;}
        if root.has-recent && root.art-available: Image {x:421px;y:116px;width:184px;height:173px;source:root.recent-artwork==0?@image-url("../../assets/illustrations/world-0.svg"):root.recent-artwork==1?@image-url("../../assets/illustrations/world-1.svg"):@image-url("../../assets/illustrations/world-2.svg");image-fit:contain;}
        Text {x:32px;y:231px;width:362px;height:47px;text:root.has-recent?"Tu aventura sigue aquí.":"Tu último juego aparecerá aquí después de una partida registrada.";wrap:word-wrap;font-size:15px;color:QuietDesign.muted;}
        if root.has-recent: QuietAction {x:32px;y:300px;width:236px;height:47px;label:"Continuar";focused:root.selected==0;pressed:root.confirmed;reduced:root.reduced;enabled:root.resume&&!root.blocked;chosen=>{root.activated(0);}}
        QuietAction {x:root.has-recent?420px:32px;y:300px;width:root.has-recent?184px:236px;height:47px;label:"Biblioteca";focused:root.selected==2;reduced:root.reduced;enabled:root.resume&&!root.blocked;chosen=>{root.activated(2);}}
        Text {x:32px;y:376px;width:576px;text:root.statistics;overflow:elide;font-size:12px;color:QuietDesign.muted;}
    }
    Rectangle {
        property <float> show:root.resume?0:1;
        x:(1-show)*8px;y:0px;width:640px;height:480px;background:QuietDesign.paper;
        visible:!root.resume;opacity:1;
        animate show {duration:root.reduced?0ms:QuietDesign.transition;easing:ease-out;}
        Rectangle {x:0px;y:0px;width:640px;height:287px;clip:true;
            RoomScene {x:0px;y:0px;width:640px;height:287px;phase:root.phase;weather:root.weather;season:root.season;decoration:root.decoration;reduced:root.reduced||!root.ambient-motion;}
        }
        Text {x:32px;y:300px;text:"emotional";font-size:14px;font-weight:600;letter-spacing:1px;color:QuietDesign.muted;}
        Text {x:505px;y:300px;width:103px;text:root.clock;horizontal-alignment:right;font-size:14px;color:QuietDesign.muted;}
        Text {x:32px+(1-root.reveal)*4px;y:326px;width:576px;height:47px;text:root.count>0?root.title:"Todo empieza con un juego";overflow:elide;font-family:"DejaVu Serif";font-size:27px;color:QuietDesign.ink;}
        QuietAction {x:32px;y:376px;width:236px;height:40px;label:root.play;focused:root.selected==0;pressed:root.confirmed;reduced:root.reduced;enabled:!root.resume&&!root.blocked&&root.count>0;chosen=>{root.activated(0);}}
        QuietAction {x:422px;y:376px;width:184px;height:40px;label:"Biblioteca";focused:root.selected==2;reduced:root.reduced;enabled:!root.resume&&!root.blocked;chosen=>{root.activated(2);}}
        if root.count>1: Rectangle {x:32px;y:431px;width:574px;height:23px;background:transparent;
            Text {x:0px;width:560px;height:23px;text:"También · " + root.alternative;overflow:elide;color:QuietDesign.muted;font-size:13px;}
            Rectangle {visible:root.selected==1;x:-10px;y:7px;width:3px;height:6px;background:QuietDesign.mark;}
            TouchArea {enabled:!root.blocked;clicked=>{root.activated(1);}}
        }
    }
    Text {x:32px;y:root.resume?438px:464px;width:574px;text:root.resume?"L / R   Descubrir     ·     A continuar     ·     Start opciones":"L / R   Volver a tu partida     ·     Start opciones";font-size:12px;color:QuietDesign.muted;}
}
