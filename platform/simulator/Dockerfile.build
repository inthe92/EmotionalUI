FROM rust:1.99.1-slim-trixie@sha256:4df2ae8cfdfebdfc13a65da7f253b73d68983dc0339f2719bc17a279c913b13d
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libfontconfig1-dev libfreetype6-dev libinput-dev libxkbcommon-dev \
    libudev-dev libdrm-dev libgbm-dev python3 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy
WORKDIR /workspace
ENV CARGO_BUILD_JOBS=2 CARGO_TARGET_DIR=/build/target CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
ENTRYPOINT ["sh", "/workspace/platform/simulator/validate-linux.sh"]
