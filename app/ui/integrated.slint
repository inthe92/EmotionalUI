import { MotionDesign } from "motion.slint";
import "../../assets/fonts/DejaVuSans.ttf";
import "../../assets/fonts/DejaVuSans-Bold.ttf";
import { DaycycleAssets } from "../../assets/scenes/daycycle/assets.slint";
export global AtmosphereDesign {
    // Only set by explicit EMOTIONAL_PERF diagnostics; never persisted.
    in-out property <int> diagnostic-mode:0;
    in-out property <[image]> scene-rasters:[];
    in-out property <bool> scene-raster-ready:false;
    in-out property <int> cached-weather:-1;
    in-out property <int> cached-event:-1;
    in-out property <[image]> near-rasters:[];
    in-out property <int> near-key:-1;
    in-out property <int> near-next-key:-1;
    in-out property <image> base-cache;
    in-out property <bool> base-cache-ready:false;
    in-out property <int> base-cache-builds:0;
    in-out property <int> base-cache-hits:0;
    in-out property <image> near-cache;
    in-out property <bool> near-cache-ready:false;
    out property <string> family:"DejaVu Sans";
    out property <color> base:DaycycleAssets.base;
    out property <color> ink:DaycycleAssets.ink;
    out property <color> muted:DaycycleAssets.muted;
    out property <color> mark:DaycycleAssets.mark;
    out property <color> glass:DaycycleAssets.glass;
    out property <color> sheet:DaycycleAssets.sheet;
    // Shared 2px antialiased surfaces, prepared offline for each atmosphere.
    out property <image> material:DaycycleAssets.material;
    out property <image> material-focus:DaycycleAssets.material-focus;
    out property <image> tile-material:DaycycleAssets.tile;
    out property <image> tile-material-focus:DaycycleAssets.tile-focus;
    out property <image> action-material:DaycycleAssets.action;
    out property <image> action-material-focus:DaycycleAssets.action-focus;
    out property <image> status-material:DaycycleAssets.status;
    out property <image> status-material-focus:DaycycleAssets.status-focus;
    out property <image> dock-material:DaycycleAssets.dock;
    out property <image> dock-active:DaycycleAssets.dock-selection-active;
    out property <image> dock-focus:DaycycleAssets.dock-selection-focus;
    out property <image> dock-active-focus:DaycycleAssets.dock-selection-active-focus;
    out property <brush> fallback:@linear-gradient(125deg,DaycycleAssets.fallback-top,DaycycleAssets.fallback-bottom);
    out property <color> border:DaycycleAssets.border;
    out property <color> rim:DaycycleAssets.rim;
    out property <color> active:DaycycleAssets.active;
    out property <color> shadow:DaycycleAssets.shadow;
    out property <length> shadow-blur:0px;
    out property <length> margin:24px;
    // One shared room plane; foreground cards travel further than the landscape.
    out property <length> scene-width:664px;
    out property <length> scene-height:498px;
    out property <length> scene-left:-12px;
    out property <length> scene-top:-9px;
    out property <length> pad:16px;
    out property <length> gap:12px;
    out property <length> radius-l:16px;
    out property <length> radius-m:12px;
    out property <length> radius-s:8px;
    out property <length> radius-xs:6px;
    out property <length> radius:self.radius-l;
    out property <length> art-radius:self.radius-m;
    out property <length> resume-art-width:112px;
    out property <length> resume-art-height:160px;
    out property <length> discover-art-width:176px;
    out property <length> resume-card-width:448px;
    out property <length> discover-card-width:400px;
    out property <length> resume-secondary-width:216px;
    out property <length> editorial-text-x:148px;
    out property <length> discover-art-height:104px;
    out property <length> tile-art-width:64px;
    out property <length> tile-art-height:40px;
    out property <length> focus-width:2px;
    out property <length> border-width:2px;
    out property <length> section-title-size:36px;
    out property <length> title-size:22px;
    out property <length> long-title-size:19px;
    out property <length> tile-size:14px;
    out property <length> body-size:13px;
    out property <length> small-size:11px;
    out property <length> meta-size:10px;
    out property <length> clock-size:24px;
    out property <length> action-size:15px;
    out property <length> action-width:188px;
    out property <length> action-height:36px;
    out property <length> action-radius:self.action-height/2;
    out property <length> action-icon:20px;
    out property <length> dock-width:400px;
    out property <length> dock-height:32px;
    out property <length> dock-bottom:12px;
    out property <length> dock-x:self.margin;
    out property <length> dock-y:16px;
    out property <length> dock-radius:self.dock-height/2;
    out property <length> dock-icon:16px;
    out property <duration> transition:MotionDesign.panel-ms*1ms;
    out property <duration> section-time:MotionDesign.section-ms*1ms;
    out property <duration> press-time:MotionDesign.press-ms*1ms;
    // The section follows cubic ease-out: 0.75 is reached after ~81 ms at 220 ms.
    out property <float> secondary-start:0.75;
}
component Cover inherits Image {
    in property <int> index;
    source:root.index==0?@image-url("../../assets/illustrations/world-0.svg"):root.index==1?@image-url("../../assets/illustrations/world-1.svg"):root.index==2?@image-url("../../assets/illustrations/world-2.svg"):root.index==3?@image-url("../../assets/illustrations/world-3.svg"):root.index==4?@image-url("../../assets/illustrations/world-4.svg"):@image-url("../../assets/illustrations/world-5.svg");
    image-fit:cover;
}
component EditorialArtwork inherits Rectangle {
    in property <length> radius:AtmosphereDesign.art-radius;
    in property <image> prepared;
    in property <bool> available;
    in property <bool> demo;
    in property <int> index;
    in property <string> title;
    in property <string> category;
    border-radius:root.radius;clip:true;background:AtmosphereDesign.fallback;
    if root.available: Image {width:parent.width;height:parent.height;source:root.prepared;image-fit:contain;}
    if !root.available&&root.demo: Cover {width:parent.width;height:parent.height;index:root.index;}
    if !root.available&&!root.demo: Text {x:16px;y:16px;width:parent.width - 32px;height:parent.height - 64px;text:root.title;wrap:word-wrap;vertical-alignment:center;horizontal-alignment:center;font-family:AtmosphereDesign.family;font-size:parent.width>180px?AtmosphereDesign.long-title-size:AtmosphereDesign.small-size;font-weight:600;color:AtmosphereDesign.ink;}
    if !root.available&&!root.demo: Text {x:16px;y:parent.height - 36px;width:parent.width - 32px;height:16px;text:root.category=="Sin clasificar"?"":root.category;horizontal-alignment:center;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.small-size;color:AtmosphereDesign.muted;}
}
component AmbientSurface inherits Rectangle {
    in property <image> first;
    in property <image> second;
    background:transparent;
    // Compensate source-over coverage (~94% inside the baked materials).
    // Both endpoints are exact; no translucent double layer remains at a keyframe.
    Image {width:parent.width;height:parent.height;source:root.first;opacity:(1-DaycycleAssets.day-mix)/(1-DaycycleAssets.day-mix*DaycycleAssets.material-coverage);image-fit:fill;image-rendering:smooth;}
    if DaycycleAssets.day-mix>0: Image {width:parent.width;height:parent.height;source:root.second;opacity:DaycycleAssets.day-mix;image-fit:fill;image-rendering:smooth;}
    Image {width:parent.width;height:parent.height;source:root.first;colorize:DaycycleAssets.context-color;opacity:DaycycleAssets.surface-wash;image-fit:fill;image-rendering:smooth;}
}
export component AmbientPanel inherits Rectangle {
    in property <bool> focused;
    in property <image> surface:AtmosphereDesign.material;
    in property <image> focused-surface:AtmosphereDesign.material-focus;
    in property <image> next-surface:DaycycleAssets.material-next;
    in property <image> next-focused-surface:DaycycleAssets.material-focus-next;
    in property <length> radius:AtmosphereDesign.radius-l;
    background:transparent;
    border-radius:root.radius;
    border-width:0px;
    AmbientSurface {width:parent.width;height:parent.height;first:root.focused?root.focused-surface:root.surface;second:root.focused?root.next-focused-surface:root.next-surface;}
}
component GameTitle inherits Text {
    in property <bool> compact:false;
    font-family:AtmosphereDesign.family;
    font-size:root.compact?AtmosphereDesign.long-title-size:AtmosphereDesign.title-size;
    font-weight:600;color:AtmosphereDesign.ink;wrap:word-wrap;
}
component AmbientAction inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> reduced;
    in property <bool> pressed;
    in property <bool> enabled:true;
    callback chosen();
    width:AtmosphereDesign.action-width;height:AtmosphereDesign.action-height;
    border-radius:AtmosphereDesign.action-radius;
    background:transparent;
    border-width:0px;
    AmbientSurface {width:parent.width;height:parent.height;first:root.focused?AtmosphereDesign.action-material-focus:AtmosphereDesign.action-material;second:root.focused?DaycycleAssets.action-focus-next:DaycycleAssets.action-next;}
    property <length> inset:root.pressed&&!root.reduced?1px:0px;
    animate inset {duration:root.reduced?0ms:AtmosphereDesign.press-time;easing:ease-out;}
    Rectangle {x:12px+root.inset;y:(parent.height - AtmosphereDesign.action-icon)/2;width:AtmosphereDesign.action-icon;height:AtmosphereDesign.action-icon;border-radius:AtmosphereDesign.action-icon/2;background:root.focused?AtmosphereDesign.mark:AtmosphereDesign.muted;
        Text {width:parent.width;height:parent.height;text:"A";font-family:AtmosphereDesign.family;font-size:12px;font-weight:700;color:AtmosphereDesign.base;horizontal-alignment:center;vertical-alignment:center;}
    }
    Text {x:40px+root.inset;width:parent.width - 52px;height:parent.height;text:root.label;font-family:AtmosphereDesign.family;color:AtmosphereDesign.ink;font-size:AtmosphereDesign.action-size;font-weight:600;vertical-alignment:center;horizontal-alignment:center;}
    TouchArea {enabled:root.enabled;clicked=>{root.chosen();}}
}
component CompactGame inherits AmbientPanel {
    radius:AtmosphereDesign.radius-m;
    surface:AtmosphereDesign.tile-material;
    focused-surface:AtmosphereDesign.tile-material-focus;
    next-surface:DaycycleAssets.tile-next;next-focused-surface:DaycycleAssets.tile-focus-next;
    in property <string> title;
    in property <image> prepared;
    in property <bool> available;
    in property <bool> demo;
    in property <int> index;
    in property <bool> enabled:true;
    callback chosen();
    property <bool> has-art:root.available||root.demo;
    if root.has-art: EditorialArtwork {x:8px;y:(parent.height - AtmosphereDesign.tile-art-height)/2;width:AtmosphereDesign.tile-art-width;height:AtmosphereDesign.tile-art-height;radius:AtmosphereDesign.radius-xs;prepared:root.prepared;available:root.available;demo:root.demo;index:root.index;}
    Text {x:root.has-art?84px:16px;y:4px;width:parent.width - self.x - 12px;height:parent.height - 8px;text:root.title;wrap:word-wrap;overflow:elide;vertical-alignment:center;font-family:AtmosphereDesign.family;font-size:root.title.character-count>36?AtmosphereDesign.body-size:AtmosphereDesign.tile-size;font-weight:600;color:AtmosphereDesign.ink;}
    TouchArea {enabled:root.enabled;clicked=>{root.chosen();}}
}
// Global tabs share one geometry in every section. Active and focus are separate.
export component SectionDock inherits Rectangle {
    in property <int> active;
    in property <int> cursor:-1;
    in property <bool> blocked;
    in property <bool> reduced;
    in property <float> position;
    callback chosen(int);
    width:AtmosphereDesign.dock-width;height:AtmosphereDesign.dock-height;
    border-radius:self.height/2;
    background:AtmosphereDesign.sheet.with-alpha(0.76);
    for label[index] in ["Continuar","Tu momento","Biblioteca","Ajustes"]: Rectangle {
        x:index*100px;width:100px;height:32px;border-radius:AtmosphereDesign.radius-s;
        background:root.active==index?AtmosphereDesign.active.with-alpha(0.65):transparent;
        border-width:root.cursor==index&&!root.blocked?AtmosphereDesign.focus-width:0px;
        border-color:AtmosphereDesign.mark;
        Text {x:4px;width:92px;height:30px;text:label;horizontal-alignment:center;vertical-alignment:center;font-family:AtmosphereDesign.family;font-size:12px;font-weight:root.active==index?700:500;color:root.active==index?AtmosphereDesign.ink:AtmosphereDesign.muted;}
        TouchArea {enabled:!root.blocked;clicked=>{root.chosen(index);}}
    }
    Rectangle {
        x:8px+root.position*100px;y:30px;width:84px;height:2px;border-radius:1px;
        background:DaycycleAssets.dock-accent;
    }
}
export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> clock;
    in property <string> date;
    background:transparent;
    Text {x:AtmosphereDesign.margin;y:64px;width:400px;height:44px;text:root.title;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.section-title-size;font-weight:700;color:AtmosphereDesign.ink;}
    Text {x:AtmosphereDesign.margin;y:112px;width:400px;height:32px;text:root.subtitle;wrap:word-wrap;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.body-size;color:AtmosphereDesign.muted;}
    Text {x:528px;y:64px;width:88px;height:28px;text:root.clock;horizontal-alignment:right;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.clock-size;font-weight:700;color:AtmosphereDesign.ink;}
    Text {x:440px;y:100px;width:176px;height:16px;text:root.date;horizontal-alignment:right;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.small-size;color:AtmosphereDesign.muted;}
}
export component RoomScene inherits Rectangle {
    in property <int> phase;
    in property <length> pan:0px;
    in property <int> weather;
    in property <int> season;
    in property <int> decoration;
    in property <bool> reduced;
    in property <int> background-index:7;
    in property <color> target-tint;
    in property <float> target-lamp;
    property <color> tint:root.target-tint;
    property <float> lamp:root.target-lamp;
    property <length> effective-pan:AtmosphereDesign.diagnostic-mode>0?0px:root.pan*MotionDesign.far-travel;
    property <bool> base-cached:AtmosphereDesign.base-cache-ready&&AtmosphereDesign.diagnostic-mode<2;
    property <bool> near-cached:AtmosphereDesign.near-cache-ready&&AtmosphereDesign.diagnostic-mode<2;
    background:AtmosphereDesign.base;clip:true;
    Image {x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:root.base-cached?AtmosphereDesign.base-cache:DaycycleAssets.backgrounds[max(0,min(7,DaycycleAssets.palette-index))];image-fit:contain;}
    if !root.base-cached&&AtmosphereDesign.diagnostic-mode<2&&DaycycleAssets.day-mix>0: Image {x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:DaycycleAssets.backgrounds[max(0,min(7,DaycycleAssets.palette-next-index))];opacity:DaycycleAssets.day-mix;image-fit:contain;}
    // Derived near-field strip; cached on keyframe changes, not on navigation.
    Image {x:AtmosphereDesign.scene-left+round(root.pan/1px*MotionDesign.near-travel)*1px;y:336px;width:664px;height:root.near-cached?24px:153px;source:AtmosphereDesign.near-rasters[0];source-clip-width:664;source-clip-height:root.near-cached?24:153;image-fit:fill;}
    if DaycycleAssets.day-mix>0: Image {x:AtmosphereDesign.scene-left+round(root.pan/1px*MotionDesign.near-travel)*1px;y:336px;width:664px;height:root.near-cached?24px:153px;source:AtmosphereDesign.near-rasters[1];source-clip-width:664;source-clip-height:root.near-cached?24:153;opacity:DaycycleAssets.day-mix;image-fit:fill;}
    if root.near-cached: Image {x:AtmosphereDesign.scene-left+round(root.pan/1px*MotionDesign.near-travel)*1px;y:360px;width:664px;height:129px;source:AtmosphereDesign.near-cache;image-fit:fill;}
    // Two adjacent lighting studies share one room; updated once per minute.
    animate tint,lamp {duration:root.reduced||AtmosphereDesign.diagnostic-mode>0?0ms:MotionDesign.ambient-ms*1ms;}
    // Reuses the former scene-tint pass; masks room surfaces, protecting glass
    // and the lantern core. Cached vector, no new animation or full-frame filter.
    Image {visible:AtmosphereDesign.diagnostic-mode<2&&(root.tint.alpha>0||DaycycleAssets.interior-tint.alpha>0);x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[0]:@image-url("../../assets/scenes/daycycle/interior-light-mask.svg");colorize:root.tint.alpha>0?root.tint:DaycycleAssets.interior-tint;image-fit:contain;}
    Rectangle {visible:AtmosphereDesign.diagnostic-mode<2;x:0px;y:0px;width:640px;height:480px;
        property <color> grade:DaycycleAssets.background-tint.mix(DaycycleAssets.daylight-tint,1-DaycycleAssets.vegetation-strength*DaycycleAssets.seasonal-light-mix);
        animate grade {duration:root.reduced||AtmosphereDesign.diagnostic-mode>0?0ms:MotionDesign.ambient-ms*1ms;}
        background:self.grade;}
    // Window overlays are restricted to the same glass rectangle in every variant.
    Image {visible:AtmosphereDesign.diagnostic-mode<2;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[1]:@image-url("../../assets/scenes/daycycle/vegetation-mask.svg");
        property <color> seasonal:DaycycleAssets.vegetation-tint;
        animate seasonal {duration:root.reduced||AtmosphereDesign.diagnostic-mode>0?0ms:MotionDesign.ambient-ms*1ms;}
        colorize:self.seasonal;opacity:DaycycleAssets.vegetation-strength;image-fit:contain;}

    // Weather only: fixed, cached SVG layers inside the glass. Never inferred from season.
    Image {visible:AtmosphereDesign.diagnostic-mode<2&&DaycycleAssets.weather-window-tint.alpha>0;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[2]:@image-url("../../assets/scenes/daycycle/weather-window.svg");colorize:DaycycleAssets.weather-window-tint;image-fit:contain;}
    if root.weather==2: Image {visible:AtmosphereDesign.diagnostic-mode<2;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[3]:@image-url("../../assets/scenes/daycycle/rain-window.svg");image-fit:contain;}
    if root.weather==4: Image {visible:AtmosphereDesign.diagnostic-mode<2;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[4]:@image-url("../../assets/scenes/daycycle/snow-window.svg");image-fit:contain;}
    // Original small vector ornament, linked to optional cultural observances.
    if root.decoration==1: Image {visible:AtmosphereDesign.diagnostic-mode<2;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[5]:@image-url("../../assets/scenes/daycycle/halloween-table.svg");image-fit:contain;}
    if root.decoration==2: Image {visible:AtmosphereDesign.diagnostic-mode<2;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[6]:@image-url("../../assets/scenes/daycycle/christmas-table.svg");image-fit:contain;}
    if root.decoration==3: Image {visible:AtmosphereDesign.diagnostic-mode<2;x:AtmosphereDesign.scene-left+round(root.effective-pan/1px)*1px;y:AtmosphereDesign.scene-top;width:AtmosphereDesign.scene-width;height:AtmosphereDesign.scene-height;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[7]:@image-url("../../assets/scenes/daycycle/new-year-table.svg");image-fit:contain;}

}
export component Integrated inherits Rectangle {
    in property <int> background-index:7;
    in property <color> ambient-tint;
    in property <float> ambient-lamp;
    in property <[float]> page-offsets;
    in property <[float]> secondary-offsets;
    in property <image> resume-cover;
    in property <bool> resume-art-available;
    in property <bool> show-content:true;
    in property <string> heading;
    in property <bool> resume;
    in property <length> pan:0px;
    in property <int> resume-count;
    in property <string> resume-two;
    in property <string> resume-three;
    in property <int> resume-two-artwork;
    in property <int> resume-three-artwork;
    in property <string> resume-detail;
    in property <string> editorial-reason;
    in property <string> category;
    in property <bool> demo-art;
    in property <float> section-position;
    in property <float> discovery-main;
    in property <float> discovery-secondary;
    in property <bool> has-recent;
    in property <string> recent-title;
    in property <int> recent-artwork;
    in property <string> statistics;
    in property <bool> demo-history;
    in property <string> title;
    in property <string> detail;
    in property <int> artwork;
    in property <string> alternative;
    in property <string> clock;
    in property <string> date;
    in property <string> play;
    in property <int> count;
    in property <int> selected;
    in property <int> phase;
    in property <int> weather;
    in property <int> season;
    in property <int> decoration;
    in property <bool> reduced;
    in property <bool> ambient-motion;
    in property <bool> blocked;
    in property <bool> confirmed;
    in property <bool> art-available;
    in property <image> local-cover;
    in property <image> alternative-cover;
    in property <bool> alternative-art-available;
    in property <image> resume-two-cover;
    in property <bool> resume-two-art-available;
    in property <image> resume-three-cover;
    in property <bool> resume-three-art-available;
    in property <bool> trial-mode;
    in property <bool> local-art-available;
    in property <float> reveal;
    property <float> secondary-progress:!root.resume&&!root.blocked&&(root.selected==1||root.selected==2)?1:root.discovery-secondary;
    property <bool> extended-title:root.title.character-count>60;
    property <bool> compact-title:root.title.character-count>38;
    property <bool> has-category:root.category!=""&&root.category!="Sin clasificar";
    callback activated(int);
    background:AtmosphereDesign.base;
    RoomScene {width:640px;height:480px;pan:root.pan;phase:root.phase;background-index:root.background-index;target-tint:root.ambient-tint;target-lamp:root.ambient-lamp;weather:root.weather;season:root.season;decoration:root.decoration;reduced:root.reduced||!root.ambient-motion;}
    Image {width:640px;height:480px;source:AtmosphereDesign.scene-raster-ready?AtmosphereDesign.scene-rasters[8]:@image-url("../../assets/scenes/lofi-room-v2/reading-mask.svg");}

    // Only the content plane moves; the landscape and system anchors stay put.
    Rectangle {x:0px;y:0px;width:MotionDesign.content-span*1px;height:480px;clip:true;background:transparent;
    Rectangle {
        x:root.page-offsets[0]*(MotionDesign.content-span/MotionDesign.page-span)*1px;width:640px;height:480px;
        visible:root.show-content&&root.page-offsets[0]>-640&&root.page-offsets[0]<640;background:transparent;
        AmbientPanel {
            x:24px;y:152px;width:AtmosphereDesign.resume-card-width;height:192px;
            focused:root.selected==0&&root.resume&&!root.blocked&&root.has-recent;
            property <bool> cover-visible:root.has-recent&&(root.resume-art-available||root.demo-art);
            property <length> text-x:self.cover-visible?144px:16px;
            property <bool> long-title:root.recent-title.character-count>38;
            // This is a separate inset cover, not the panel's inner contour:
            // subtracting the 16px content padding erased its rounded corners.
            if self.cover-visible: EditorialArtwork {x:16px;y:16px;width:AtmosphereDesign.resume-art-width;height:AtmosphereDesign.resume-art-height;radius:AtmosphereDesign.radius-s;prepared:root.resume-cover;available:root.resume-art-available;demo:root.demo-art;index:root.recent-artwork;title:root.recent-title;category:root.category;}
            Text {x:parent.text-x;y:16px;width:parent.width - self.x - 16px;height:14px;text:root.demo-history?"PARTIDAS DE MUESTRA":root.has-recent?"TU PARTIDA":"SIN PARTIDAS RECIENTES";font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.meta-size;letter-spacing:1px;color:AtmosphereDesign.muted;}
            GameTitle {x:parent.text-x;y:40px;width:parent.width - self.x - 16px;height:parent.long-title?72px:56px;text:root.recent-title;compact:parent.long-title;}
            Text {x:parent.text-x;y:parent.long-title?112px:104px;width:parent.width - self.x - 16px;height:32px;text:root.has-recent?(root.resume-detail.character-count<=100?root.resume-detail:""):"Cuando abras un juego, encontrarás aquí tu lugar para volver.";wrap:word-wrap;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.body-size;color:AtmosphereDesign.muted;}
            if root.has-recent: AmbientAction {x:parent.text-x;y:140px;label:root.has-recent?"Continuar":"Tu biblioteca";focused:root.selected==(root.has-recent?0:2)&&root.resume&&!root.blocked;pressed:root.confirmed;reduced:root.reduced;enabled:root.resume&&!root.blocked;chosen=>{root.activated(root.has-recent?0:2);}}
        }
        Text {x:24px;y:348px;width:AtmosphereDesign.resume-card-width;height:16px;text:root.statistics;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.small-size;color:AtmosphereDesign.muted;}
        if root.resume-count>1: CompactGame {x:24px+(root.secondary-offsets[0]-root.page-offsets[0])*(MotionDesign.content-span/MotionDesign.page-span)*1px;y:root.resume-two.character-count>52?368px:376px;width:AtmosphereDesign.resume-secondary-width;height:root.resume-two.character-count>52?80px:56px;title:root.resume-two;prepared:root.resume-two-cover;available:root.resume-two-art-available;demo:root.demo-art;index:root.resume-two-artwork;focused:root.selected==4&&root.resume&&!root.blocked;enabled:root.resume&&!root.blocked;chosen=>{root.activated(4);}}
        if root.resume-count>2: CompactGame {x:256px+(root.secondary-offsets[0]-root.page-offsets[0])*(MotionDesign.content-span/MotionDesign.page-span)*1px;y:root.resume-three.character-count>52?368px:376px;width:AtmosphereDesign.resume-secondary-width;height:root.resume-three.character-count>52?80px:56px;title:root.resume-three;prepared:root.resume-three-cover;available:root.resume-three-art-available;demo:root.demo-art;index:root.resume-three-artwork;focused:root.selected==5&&root.resume&&!root.blocked;enabled:root.resume&&!root.blocked;chosen=>{root.activated(5);}}
    }

    Rectangle {
        x:root.page-offsets[1]*(MotionDesign.content-span/MotionDesign.page-span)*1px;width:640px;height:480px;
        visible:root.show-content&&root.page-offsets[1]>-640&&root.page-offsets[1]<640;background:transparent;
        AmbientPanel {
            x:24px;y:root.extended-title?152px:160px;width:400px;height:root.extended-title?216px:208px;
            focused:root.selected==0&&!root.resume&&!root.blocked&&root.count>0;
            EditorialArtwork {x:12px;y:12px;width:AtmosphereDesign.discover-art-width;height:AtmosphereDesign.discover-art-height;radius:AtmosphereDesign.radius-s;prepared:root.local-cover;available:root.local-art-available;demo:root.demo-art&&root.count>0;index:root.artwork;title:root.count>0?root.title:"Tu colección te espera";category:root.category;}
            Text {x:12px;y:128px;width:176px;height:68px;text:root.count>0?root.editorial-reason:"Cuando añadas juegos, encontrarás aquí una propuesta.";wrap:word-wrap;font-family:AtmosphereDesign.family;font-size:AtmosphereDesign.body-size;color:AtmosphereDesign.muted;}
            GameTitle {x:204px;y:16px;width:184px;height:root.extended-title?140px:120px;text:root.count>0?root.title:"Tu colección te espera";compact:root.compact-title;}
            if root.count>0: AmbientAction {x:200px;y:160px;label:root.play;focused:root.selected==0&&!root.resume&&!root.blocked;pressed:root.confirmed;reduced:root.reduced;enabled:!root.resume&&!root.blocked;chosen=>{root.activated(0);}}
        }
    }
    Rectangle {
        x:root.secondary-offsets[1]*(MotionDesign.content-span/MotionDesign.page-span)*1px;width:640px;height:480px;
        visible:root.show-content&&root.secondary-offsets[1]>-640&&root.secondary-offsets[1]<640;background:transparent;
        if root.count>1: CompactGame {x:176px;y:root.extended-title?384px:380px;width:248px;height:root.alternative.character-count>52?64px:48px;title:root.alternative;prepared:root.alternative-cover;available:root.alternative-art-available;focused:root.selected==1&&!root.resume&&!root.blocked;enabled:!root.resume&&!root.blocked;chosen=>{root.activated(1);}}
    }
    }
}
