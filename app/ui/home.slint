        Text {visible:root.concept!=4;x:26px;y:24px;text:"A tu manera";font-size:Design.panel-title-size;font-weight:600;color:root.ink;}
        for label[index] in root.menu-titles : Rectangle {
            property <int> entry-index:index+root.menu-offset;
            property <bool> item-focused:root.menu-open&&root.dock-cursor<0&&!root.system-focused&&!root.system-open&&!root.audio-open&&!root.game-options-open&&root.menu-index==self.entry-index;
            x:12px;y:(root.concept==4?8px:74px)+index*(root.concept==4?44px:56px);width:root.concept==4?568px:476px;height:root.concept==4?40px:48px;border-radius:AtmosphereDesign.radius-m;
            background:self.item-focused?root.accent.with-alpha(0.14):transparent;
            border-width:root.concept!=4&&self.item-focused?Design.focus-width:0px;border-color:root.accent;
            if root.concept==4&&self.item-focused: FocusOutline {width:parent.width;height:parent.height;radius:AtmosphereDesign.radius-m;}
            Text {x:12px;width:root.options-open?480px:352px;height:parent.height;text:label;overflow:elide;color:root.ink;font-size:15px;vertical-alignment:center;}
            Text {x:root.options-open?492px:368px;width:root.options-open?60px:184px;height:parent.height;text:root.menu-values[index];overflow:elide;horizontal-alignment:right;vertical-alignment:center;font-size:Design.secondary-size;color:root.muted;}
            TouchArea {enabled:root.menu-open&&!root.audio-open;clicked=>{root.menu-select(index+root.menu-offset);}}
        }
        Text {visible:root.concept!=4;x:26px;y:262px;text:root.native-controls?"A elegir   ·   B volver":"Z elegir   ·   X volver";font-size:Design.secondary-size;color:root.muted;}

    }
    Rectangle {
        property <float> show:root.modal-kind==3?root.modal-progress:0;
        opacity:show;visible:show>0;
        x:24px;y:152px+(1-show)*8px;width:592px;height:288px;border-radius:AtmosphereDesign.radius-l;background:AtmosphereDesign.sheet;border-width:1px;border-color:AtmosphereDesign.glass-focus;
        TouchArea {enabled:root.audio-open;}
        Text {visible:false;x:16px;y:8px;text:"Sonido, a tu ritmo";font-size:24px;color:AtmosphereDesign.ink;}
        Text {x:16px;y:8px;width:560px;text:root.audio-status;overflow:elide;font-size:12px;color:AtmosphereDesign.muted;}
        for label[index] in ["Ambiente", "Volumen general", "Música", "Sonido de la habitación", "Sonidos de interfaz", "Volumen de interfaz", "Volver"] : Rectangle {
            x:12px;y:40px+index*32px;width:568px;height:28px;border-radius:AtmosphereDesign.radius-m;
            background:root.audio-open&&root.audio-index==index?AtmosphereDesign.mark.with-alpha(0.14):transparent;
            if root.audio-open&&root.audio-index==index: FocusOutline {width:parent.width;height:parent.height;radius:AtmosphereDesign.radius-m;}
            Text {x:12px;height:parent.height;text:label;font-size:15px;color:AtmosphereDesign.ink;vertical-alignment:center;}
            Text {x:360px;width:192px;height:parent.height;text:root.audio-values[index];font-size:13px;color:AtmosphereDesign.muted;vertical-alignment:center;horizontal-alignment:right;}
            TouchArea {enabled:root.audio-open;clicked=>{root.audio-select(index,self.mouse-x<parent.width/2?-1:1);}}
        }
        Text {x:16px;y:272px;text:"← / → ajustar   ·   A elegir   ·   B volver";font-size:12px;color:AtmosphereDesign.muted;}
    }

    Rectangle {
      visible:root.modal-kind==2&&root.modal-progress>0;opacity:root.modal-progress;
      x:24px;y:152px+(1-root.modal-progress)*MotionDesign.modal-travel*1px;width:592px;height:288px;border-radius:AtmosphereDesign.radius-l;background:AtmosphereDesign.sheet;border-width:1px;border-color:AtmosphereDesign.glass-focus;
      TouchArea {enabled:root.game-options-open;}
      Text {x:16px;y:8px;width:560px;height:40px;text:root.game-option-title;wrap:word-wrap;font-family:AtmosphereDesign.family;font-size:18px;color:AtmosphereDesign.ink;}
      for label[index] in root.game-option-labels: Rectangle {
        x:12px;y:56px+index*28px;width:568px;height:28px;border-radius:AtmosphereDesign.radius-m;
        background:root.game-options-open&&root.game-option-index==index?AtmosphereDesign.mark.with-alpha(0.14):transparent;
        if root.game-options-open&&root.game-option-index==index: FocusOutline {width:parent.width;height:parent.height;radius:AtmosphereDesign.radius-m;}
        Text {x:12px;width:450px;height:parent.height;text:label;font-size:15px;color:AtmosphereDesign.ink;vertical-alignment:center;}
        TouchArea {enabled:root.game-options-open;clicked=>{root.game-option-select(index);}}
      }
      Text {x:16px;y:232px;width:560px;height:40px;text:root.game-option-reason;wrap:word-wrap;font-size:12px;color:AtmosphereDesign.muted;}
      Text {x:16px;y:276px;text:"A elegir   ·   B volver";font-size:12px;color:AtmosphereDesign.muted;}
    }

    if root.concept==4: SectionHeader {
        x:0px;y:0px;width:640px;height:100px;
        title:root.audio-open?"Sonido":root.game-options-open?"Esta partida":root.menu-open?(root.options-open?root.settings-title:"Ajustes"):root.library-open?(root.history-panel?"Historial":"Biblioteca"):root.section-title;
        subtitle:root.ambient-label!=""?root.ambient-label:root.message!=""&&!root.menu-open&&!root.library-open?root.message:root.menu-open?(root.message!=""?root.message:root.options-open?root.settings-hint:"A tu manera."):root.library-open?(root.history-panel?"Tus momentos de juego.":"Toda tu colección, a tu ritmo."):root.resume-view?"Vuelve a tus partidas.":"Una aventura para este momento.";
        clock:root.clock;date:root.date;
    }
    if root.concept==4: SectionDock {
        x:AtmosphereDesign.dock-x;y:AtmosphereDesign.dock-y;
        active:root.active-section;cursor:root.dock-cursor;reduced:root.reduced;position:root.nav-position;
        blocked:root.audio-open||root.game-options-open||root.system-open;
        chosen(index)=>{root.navigate(index);}
    }

    // Static build identity, separate from action legends and touch targets.
    if root.concept==4: Text {
        x:416px;y:438px;width:200px;height:14px;text:root.app-version;
        horizontal-alignment:right;vertical-alignment:center;
        font-family:AtmosphereDesign.family;font-size:10px;color:AtmosphereDesign.muted;
    }

    if root.concept==4: ControlsFooter {x:24px;y:454px;width:592px;native:root.native-controls;modal:root.system-open||root.audio-open||root.game-options-open;option-count:root.game-options-open?max(0,root.game-option-labels.length - 1):0;}

    if root.concept==4: SystemControls {
        x:0px;y:0px;
        focused:root.system-focused;expanded:root.system-open;reduced:root.reduced;progress:root.modal-kind==1?root.modal-progress:0;
        blocked:root.audio-open||root.game-options-open;
        battery-percent:root.system-battery-percent;battery-charging:root.system-battery-charging;
        values:root.system-values;known:root.system-known;active:root.system-active;selected:root.system-selected;help:root.system-help;changes-allowed:root.system-controls-enabled;
        chosen(index)=>{root.system-select(index);}
        adjusted(index,forward)=>{root.system-adjust(index,forward);}
        levels:root.system-levels;level-changed(index,value)=>{root.system-level(index,value);}
        toggled=>{root.system-toggle();}
        settings=>{root.system-toggle();root.navigate(3);}
    }

}
export { AtmosphereDesign } from "integrated.slint";

export { MotionDesign } from "motion.slint";
