component HeroStory inherits Rectangle {
    background:transparent;
    in property <string> title;
    in property <string> detail;
    in property <string> tag;
    in property <int> artwork;
    in property <bool> artwork-visible:true;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    Rectangle {x:376px;y:12px;width:204px;height:198px;background:transparent;visible:root.artwork-visible;
        Image {width:parent.width;height:parent.height;source:root.artwork==0?@image-url("../../assets/illustrations/world-0.svg"):root.artwork==1?@image-url("../../assets/illustrations/world-1.svg"):root.artwork==2?@image-url("../../assets/illustrations/world-2.svg"):root.artwork==3?@image-url("../../assets/illustrations/world-3.svg"):root.artwork==4?@image-url("../../assets/illustrations/world-4.svg"):@image-url("../../assets/illustrations/world-5.svg");image-fit:contain;image-rendering:smooth;}
    }
    Text {x:22px;y:20px;width:342px;text:root.tag;overflow:elide;color:root.accent;font-size:Design.secondary-size;font-weight:600;}
    Text {x:22px;y:48px;width:342px;height:68px;text:root.title;wrap:word-wrap;overflow:elide;color:root.ink;font-size:Design.title-size;font-weight:700;}
    Text {x:22px;y:119px;width:336px;height:37px;text:root.detail;wrap:word-wrap;overflow:elide;color:root.muted;font-size:Design.body-size;}
}
component Choice inherits Glass {
    surface:@image-url("../../assets/illustrations/glass-small.svg");
    in property <string> title;
    in property <string> detail;
    in property <color> muted;
    in property <bool> available:true;
    callback activated();
    property <length> lift:self.selected ? -2px : 0px;
    out property <length> growth:self.selected && !self.reduced ? Design.focus-growth : 0px;
    animate growth {duration:root.reduced ? 0ms : Design.focus-time;easing:ease-out;}
    animate lift {duration:root.reduced ? 0ms : Design.focus-time;easing:ease-out;}
    Text {x:16px;y:12px+root.lift;width:parent.width - 32px;height:24px;text:root.title;color:root.ink;font-size:Design.action-size;font-weight:600;overflow:elide;}
    Text {x:16px;y:38px+root.lift;text:root.detail;color:root.muted;font-size:Design.secondary-size;}
    TouchArea {enabled:root.available;clicked=>{root.activated();}}
}
